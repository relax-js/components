{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "experimentalDecorators": false,
        "useDefineForClassFields": true,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["vite/client", "node"],
        "paths": {
            "@relax.js/components": ["../src/index.ts"]
        }
    },
    "include": ["**/*.ts"]
}
