{
    "name": "@relax.js/components",
    "version": "2.0.0",
    "description": "Ready-made Web Components for Relaxjs: table, tree view, tabs, top menu and spinner.",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc --emitDeclarationOnly && node build.js",
        "check": "tsc -p tsconfig.check.json",
        "test": "vitest run --config ./vitest.config.ts",
        "test:watch": "vitest --config ./vitest.config.ts",
        "publish:npm": "npm run build && npm publish --access public"
    },
    "keywords": [
        "web-components",
        "custom-elements",
        "relaxjs"
    ],
    "author": "",
    "license": "MIT",
    "peerDependencies": {
        "@relax.js/core": "^2.3.1"
    },
    "devDependencies": {
        "@relax.js/core": "^2.3.1",
        "@types/jsdom": "^21.1.7",
        "@vitest/coverage-v8": "^3.0.5",
        "esbuild": "^0.25.0",
        "jsdom": "^26.1.0",
        "typescript": "^5.7.3",
        "vite": "^6.0.7",
        "vitest": "^3.0.5"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./theme.css": "./dist/theme.css"
    },
    "files": [
        "dist",
        "docs"
    ]
}
