{
  "name": "@relax.js/components",
  "version": "2.0.3",
  "description": "Native Web Components for business apps: tables, tree views, menus, tabs, dialogs, forms, banners, and dashboard figures, meters and charts.",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --emitDeclarationOnly && npm run manifest && node build.js",
    "manifest": "cem analyze --globs \"src/**/*.ts\" --outdir dist",
    "check": "tsc -p tsconfig.check.json",
    "test": "npm run check && vitest run --config ./vitest.config.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "test:browser": "vitest run --config ./vitest.browser.config.ts",
    "demo:ops": "vite demos/ops-dashboard",
    "demo:office": "vite demos/back-office",
    "demo:finance": "vite demos/finance-tracker",
    "demo:gallery": "vite demos/gallery",
    "demo:disco": "vite demos/disco",
    "demo:screenshots": "node demos/shared/screenshot.mjs",
    "docs:screenshots": "node demos/gallery/screenshot.mjs",
    "demo:check": "tsc -p demos/tsconfig.json",
    "demo:build": "vite build demos/ops-dashboard && vite build demos/back-office && vite build demos/finance-tracker",
    "publish:npm": "npm run build && npm publish --access public"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "relaxjs"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relax-js/components.git"
  },
  "homepage": "https://github.com/relax-js/components#readme",
  "bugs": "https://github.com/relax-js/components/issues",
  "license": "MIT",
  "peerDependencies": {
    "@relax.js/core": "^2.3.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@relax.js/core": "^2.3.1",
    "@types/jsdom": "^21.1.7",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.0.5",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.64.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./theme.css": "./dist/theme.css",
    "./theme-sizes.css": "./dist/theme-sizes.css",
    "./theme-colors.css": "./dist/theme-colors.css",
    "./custom-elements.json": "./dist/custom-elements.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.mjs"
    }
  },
  "files": [
    "dist",
    "docs",
    "!docs/manual/images",
    "skills"
  ],
  "customElements": "dist/custom-elements.json",
  "sideEffects": [
    "*.css",
    "./dist/chunks/*.mjs",
    "./dist/index.mjs",
    "./dist/icon.mjs",
    "./dist/pipes.mjs",
    "./dist/text.mjs",
    "./dist/amount.mjs",
    "./dist/area-chart.mjs",
    "./dist/badge.mjs",
    "./dist/bar-chart.mjs",
    "./dist/card.mjs",
    "./dist/days-left.mjs",
    "./dist/heatmap.mjs",
    "./dist/kpi-meter.mjs",
    "./dist/line-chart.mjs",
    "./dist/meter.mjs",
    "./dist/period-grid.mjs",
    "./dist/sparkline.mjs",
    "./dist/stat-tile.mjs",
    "./dist/status-grid.mjs",
    "./dist/status-mark.mjs",
    "./dist/table.mjs",
    "./dist/treeview.mjs",
    "./dist/banner.mjs",
    "./dist/spinner.mjs",
    "./dist/file-input.mjs",
    "./dist/step.mjs",
    "./dist/dialog.mjs",
    "./dist/setting-row.mjs",
    "./dist/dropdown-menu.mjs",
    "./dist/section-nav.mjs",
    "./dist/side-menu.mjs",
    "./dist/tabs.mjs",
    "./dist/top-menu.mjs"
  ]
}
